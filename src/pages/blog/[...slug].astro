---
import Base from "../../layouts/Base.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import LangToggle from "../../components/LangToggle.astro";
import BottomNav from "../../components/BottomNav.astro";
import { useTranslations, localizePath } from "../../i18n/utils";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  // i18n: zh 文章动态路由 —— 只取缺省/zh 文章（en 文章走 en/blog/[...slug].astro）。
  const posts = (await getCollection("blog")).filter(
    (post) => (post.data.lang ?? "zh") === "zh"
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const lang = "zh";
const t = useTranslations(lang);

const { post } = Astro.props;
const { Content } = await render(post);

// 语言切换兜底：顶部「あ/A」按钮默认仅按 slug 加 /en 前缀互跳；若本文没有 en
// 译版，跳到不存在的 /en/blog/<slug> 会 404。故在此显式算出目标——en 译版文件
// 约定为同名 + `-en`（路由已去后缀）：有译版给文章 URL，无译版回退 en 博客列表。
const enPost = (await getCollection("blog")).find(
  (p) => p.data.lang === "en" && p.id === `${post.id}-en`
);
const langAltHref = enPost ? localizePath(`/blog/${post.id}`, "en") : "/en/blog";

// i18n: 边注式第二语言片段（marginalia），按顺序渲染。
const marginalia = post.data.marginalia ?? [];
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={`/og/blog/${post.id}.png`}
  lang={lang}
>
  <article class="content-page">
    <div class="page-top">
      <a href="/blog" class="back-link">{t("back.blog")}</a>
      <div class="page-top-actions">
        <LangToggle altHref={langAltHref} />
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <h1>{post.data.title}</h1>
    <p class="subtitle">{post.data.date?.toLocaleDateString("zh-CN")} {post.data.tags?.map((tag: string) => `#${tag}`).join(" ")}</p>

    <div class="prose">
      <Content />
    </div>

    {marginalia.length > 0 && (
      <div class="marginalia-list">
        {marginalia.map((m) => (
          <aside class="marginalia" lang={m.lang === "en" ? "en" : "zh-CN"}>
            {m.text}
          </aside>
        ))}
      </div>
    )}

    <BottomNav lang={lang} />
  </article>
</Base>

<style>
  .page-top-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .translation-link {
    font-family: "Noto Serif SC", serif;
    color: var(--muted);
    font-size: 0.85rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .translation-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
