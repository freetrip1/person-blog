---
// i18n: en 文章动态路由，复用 zh blog/[...slug].astro 结构；getStaticPaths 只取 lang==='en' 文章。
import Base from "../../../layouts/Base.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import LangToggle from "../../../components/LangToggle.astro";
import BottomNav from "../../../components/BottomNav.astro";
import { useTranslations, localizePath } from "../../../i18n/utils";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(
    (post) => post.data.lang === "en"
  );
  return posts.map((post) => ({
    // i18n: en 文件名以 -en 结尾，路由去掉后缀，使 /en/blog/<slug> 与 zh
    // 的 /blog/<slug> 同名，让顶部「あ/A」语言切换按钮（仅加/去 /en 前缀）能互跳。
    params: { slug: post.id.replace(/-en$/, "") },
    props: { post },
  }));
}

const lang = "en";
const t = useTranslations(lang);

const { post } = Astro.props;
const { Content } = await render(post);

// 语言切换兜底：见 zh 版注释。en→zh 去掉 `-en` 后缀查 zh 原文：有则给文章 URL，
// 无则回退 zh 博客列表，避免「あ/A」按钮跳到不存在的 /blog/<slug> 而 404。
const zhId = post.id.replace(/-en$/, "");
const zhPost = (await getCollection("blog")).find(
  (p) => (p.data.lang ?? "zh") === "zh" && p.id === zhId
);
const langAltHref = zhPost ? `/blog/${zhId}` : "/blog";

const marginalia = post.data.marginalia ?? [];
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={`/og/blog/${post.id}.png`}
  lang={lang}
>
  <article class="content-page">
    <div class="page-top">
      <a href="/en/blog" class="back-link">{t("back.blog")}</a>
      <div class="page-top-actions">
        <LangToggle altHref={langAltHref} />
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <h1>{post.data.title}</h1>
    <p class="subtitle">{post.data.date?.toLocaleDateString("en-US")} {post.data.tags?.map((tag: string) => `#${tag}`).join(" ")}</p>

    <div class="prose">
      <Content />
    </div>

    {marginalia.length > 0 && (
      <div class="marginalia-list">
        {marginalia.map((m) => (
          <aside class="marginalia" lang={m.lang === "en" ? "en" : "zh-CN"}>
            {m.text}
          </aside>
        ))}
      </div>
    )}

    <BottomNav lang={lang} />
  </article>
</Base>

<style>
  .page-top-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .translation-link {
    font-family: "Noto Serif SC", serif;
    color: var(--muted);
    font-size: 0.85rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .translation-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
